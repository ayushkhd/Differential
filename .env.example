# ShopAgent model. "auto" = claude-haiku-5-5 if ANTHROPIC_API_KEY is set, else the offline reference-sim.
SHOPAGENT_MODEL=auto
SHOPAGENT_EFFORT=low
ANTHROPIC_API_KEY=

# Build resolution (defaults shown). ShopAgent("pr") loads shopagent/inbound.py from this ref.
SHOPAGENT_MAIN_REF=main
SHOPAGENT_PR_REF=fix/sanitize-listing-input
# Or point a version at a checkout / inbound.py directly (overrides git):
# SHOPAGENT_BUILD_MAIN=/path/to/main-checkout
# SHOPAGENT_BUILD_PR=/path/to/pr-checkout

# Differential harness and backend (only these talk to ClickHouse)
CLICKHOUSE_HOST=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=1
ELEVENLABS_API_KEY=
# GitHub handoff (uses the gh CLI's own login)
DIFFERENTIAL_REPO=ayushkhd/Differential
DIFFERENTIAL_PR=2
DIFFERENTIAL_APP_URL=http://127.0.0.1:5173
# DIFFERENTIAL_GITHUB=0         # keep live runs off the PR
# DIFFERENTIAL_PR_COMMENT=1     # live UI runs also post the verdict comment
# DIFFERENTIAL_REPLAY_RUN=      # pin the replay source run
